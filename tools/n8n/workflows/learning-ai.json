    {
      "parameters": {
        "jsCode": "// The API's signature was checked before this node. Only these two calls\n// are relayed, so the webhook can't be used as a general model proxy.\nconst call = $input.first().json.body ?? {};\nconst routes = {\n  groq: {\n    origin: 'https://api.groq.com',\n    path: /^\\/openai\\/v1\\/chat\\/completions$/,\n  },\n  gemini: {\n    origin: 'https://generativelanguage.googleapis.com',\n    path: /^\\/v1beta\\/models\\/[\\w.-]+:generateContent$/,\n  },\n};\nif (call.provider === 'ping') return [{ json: { route: 'ping' } }];\nconst known = typeof call.provider === 'string' && Object.hasOwn(routes, call.provider);\nconst route = known ? routes[call.provider] : null;\nconst fits =\n  route &&\n  typeof call.path === 'string' &&\n  route.path.test(call.path) &&\n  call.body !== null &&\n  typeof call.body === 'object';\nif (!fits) return [{ json: { route: 'bad' } }];\nreturn [\n  {\n    json: { route: call.provider, url: route.origin + call.path, body: call.body },\n  },\n];\n"
      },

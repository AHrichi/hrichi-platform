    {
      "parameters": {
        "operation": "aggregate",
        "collection": "leads",
        "query": "[\n  {\n    \"$match\": {\n      \"delivery.n8n.status\": \"pending\",\n      \"$expr\": {\n        \"$lt\": [\n          \"$delivery.n8n.nextAttemptAt\",\n          {\n            \"$subtract\": [\n              \"$$NOW\",\n              120000\n            ]\n          }\n        ]\n      },\n      \"$or\": [\n        {\n          \"delivery.n8n.leaseUntil\": {\n            \"$exists\": false\n          }\n        },\n        {\n          \"$expr\": {\n            \"$lt\": [\n              \"$delivery.n8n.leaseUntil\",\n              \"$$NOW\"\n            ]\n          }\n        }\n      ]\n    }\n  },\n  {\n    \"$sort\": {\n      \"createdAt\": 1\n    }\n  },\n  {\n    \"$limit\": 20\n  },\n  {\n    \"$project\": {\n      \"_id\": 0,\n      \"id\": {\n        \"$toString\": \"$_id\"\n      },\n      \"name\": 1,\n      \"email\": 1,\n      \"intent\": 1,\n      \"audience\": 1,\n      \"humanCheck\": 1\n    }\n  }\n]"
      },

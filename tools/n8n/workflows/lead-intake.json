      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.headers['x-lead-timestamp'] }}.{{ JSON.stringify($json.body) }}",
        "dataPropertyName": "expectedSignature",
        "encoding": "hex"
      },
      "id": "969db652-3d7e-50d0-b9ac-aed50cc674b8",

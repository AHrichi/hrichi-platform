      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "ceaec2dd-6808-5c58-b5d9-f88e8d99cc12",
              "leftValue": "={{ $json.headers['x-lead-signature'] }}",
              "rightValue": "=sha256={{ $json.expectedSignature }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "73ff02d6-1178-58f0-9cf2-e204bfb4e717",
              "leftValue": "={{ Math.abs(Date.now() - Number($json.headers['x-lead-timestamp'])) }}",
              "rightValue": 300000,
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },

      "blocks": [
        {
          "id": "worst-case",
          "kind": "quiz",
          "question": "What makes a hash table lookup slow down to O(n)?",
          "code": null,
          "options": [
            "Many keys colliding in the same bucket",
            "Having too few keys",
            "Keys inserted in sorted order",
            "Using string keys"
          ],
          "correct": [0],
          "explanation": "If many keys land in one bucket, a lookup has to compare against all of them. Good hashes and resizing keep buckets short."
        }
      ]

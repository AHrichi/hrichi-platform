  "cards": [
    {
      "type": "concept",
      "front": "How does a hash table find a key in about one step?",
      "back": "A hash function turns the key into a bucket number, so the lookup goes straight to that bucket."
    },
    {
      "type": "fact",
      "front": "What is a hash collision?",
      "back": "Two different keys that hash to the same bucket."
    },
    {
      "type": "concept",
      "front": "When is a balanced search tree better than a hash table?",
      "back": "When you need keys in order or range queries; it also guarantees O(log n) in the worst case."
    },
    {
      "type": "procedure",
      "front": "What happens when a hash table resizes?",
      "back": "It allocates more buckets and rehashes every key into them, which keeps buckets short."
    }
  ]
}

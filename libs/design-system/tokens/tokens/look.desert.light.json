{
  "color": {
    "$type": "color",
    "bg": {
      "canvas": {
        "$value": "{color.paper.100}"
      },
      "surface": {
        "$value": "{color.paper.50}"
      },
      "raised": {
        "$value": "{color.neutral.0}"
      },
      "inverse": {
        "$value": "{color.night.900}"
      }
    },
    "text": {
      "default": {
        "$value": "{color.paper.950}"
      },
      "muted": {
        "$value": "{color.paper.600}"
      },
      "inverse": {
        "$value": "{color.paper.100}"
      }
    },
    "border": {
      "default": {
        "$value": "{color.paper.300}"
      },
      "strong": {
        "$value": "{color.paper.400}"
      },
      "control": {
        "$value": "{color.paper.600}"
      }
    },
    "accent": {
      "default": {
        "$value": "{color.teal.700}"
      },
      "hover": {
        "$value": "{color.teal.800}"
      },
      "subtle": {
        "$value": "{color.teal.50}"
      },
      "on": {
        "$value": "{color.neutral.0}"
      },
      "solid": {
        "$value": "{color.teal.700}"
      },
      "solid-hover": {
        "$value": "{color.teal.800}"
      },
      "on-solid": {
        "$value": "{color.neutral.0}"
      }
    },
    "success": {
      "default": {
        "$value": "{color.sage.700}"
      },
      "subtle": {
        "$value": "{color.sage.50}"
      }
    },
    "warning": {
      "default": {
        "$value": "{color.amber.800}"
      },
      "subtle": {
        "$value": "{color.amber.50}"
      }
    },
    "info": {
      "default": {
        "$value": "{color.blue.700}"
      },
      "subtle": {
        "$value": "{color.blue.50}"
      }
    },
    "danger": {
      "default": {
        "$value": "{color.red.700}"
      },
      "subtle": {
        "$value": "{color.red.50}"
      }
    },
    "focus": {
      "ring": {
        "$value": "{color.amber.700}"
      }
    }
  }
}

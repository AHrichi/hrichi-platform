{
  "color": {
    "$type": "color",
    "bg": {
      "canvas": { "$value": "{color.neutral.0}" },
      "surface": { "$value": "{color.neutral.50}" },
      "raised": { "$value": "{color.neutral.0}" },
      "inverse": { "$value": "{color.neutral.900}" }
    },
    "text": {
      "default": { "$value": "{color.neutral.900}" },
      "muted": { "$value": "{color.neutral.600}" },
      "inverse": { "$value": "{color.neutral.50}" }
    },
    "border": {
      "default": { "$value": "{color.neutral.200}" },
      "strong": { "$value": "{color.neutral.300}" }
    },
    "accent": {
      "default": { "$value": "{color.crimson.600}" },
      "hover": { "$value": "{color.crimson.700}" },
      "subtle": { "$value": "{color.crimson.50}" },
      "on": { "$value": "{color.neutral.0}" }
    },
    "success": {
      "default": { "$value": "{color.green.600}" }
    },
    "focus": {
      "ring": { "$value": "{color.crimson.500}" }
    }
  },
  "shadow": {
    "raised": {
      "$value": "0 1px 2px rgb(15 15 18 / 6%), 0 4px 16px rgb(15 15 18 / 6%)"
    }
  }
}

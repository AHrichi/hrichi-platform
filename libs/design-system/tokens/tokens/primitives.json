{
  "color": {
    "$type": "color",
    "crimson": {
      "50": { "$value": "#fdf2f4" },
      "100": { "$value": "#fbe3e7" },
      "200": { "$value": "#f6c7cf" },
      "300": { "$value": "#ee9aa8" },
      "400": {
        "$value": "#e66f85",
        "$description": "Dark-theme accent; 5:1 on bg.raised"
      },
      "500": { "$value": "#d03553" },
      "600": {
        "$value": "#b3122e",
        "$description": "Brand accent, taken from the CV"
      },
      "700": { "$value": "#960f27" },
      "800": { "$value": "#7a0e22" },
      "900": { "$value": "#3a0811" }
    },
    "neutral": {
      "0": { "$value": "#ffffff" },
      "50": { "$value": "#f7f7f8" },
      "100": { "$value": "#eeeef0" },
      "200": { "$value": "#dcdce0" },
      "300": { "$value": "#c2c2c8" },
      "400": { "$value": "#9a9aa3" },
      "500": { "$value": "#74747d" },
      "600": { "$value": "#56565e" },
      "700": { "$value": "#3d3d44" },
      "800": { "$value": "#26262b" },
      "900": { "$value": "#18181b" },
      "950": { "$value": "#0f0f12" }
    },
    "green": {
      "400": { "$value": "#4ade80" },
      "600": { "$value": "#15803d" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": "'Inter Variable', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
      },
      "mono": {
        "$value": "ui-monospace, 'Cascadia Code', 'JetBrains Mono', Consolas, monospace"
      }
    },
    "size": {
      "$type": "dimension",
      "$description": "Fluid type scale: min at 360px, max at 1280px viewport",
      "100": { "$value": "0.8125rem" },
      "200": { "$value": "0.9375rem" },
      "300": { "$value": "clamp(1rem, 0.96rem + 0.18vw, 1.0625rem)" },
      "400": { "$value": "clamp(1.125rem, 1.07rem + 0.27vw, 1.25rem)" },
      "500": { "$value": "clamp(1.375rem, 1.26rem + 0.54vw, 1.625rem)" },
      "600": { "$value": "clamp(1.75rem, 1.52rem + 1.05vw, 2.375rem)" },
      "700": { "$value": "clamp(2.25rem, 1.84rem + 1.85vw, 3.5rem)" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.15 },
      "snug": { "$value": 1.35 },
      "normal": { "$value": 1.6 }
    }
  },
  "space": {
    "$type": "dimension",
    "0": { "$value": "0" },
    "1": { "$value": "0.25rem" },
    "2": { "$value": "0.5rem" },
    "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" },
    "5": { "$value": "1.5rem" },
    "6": { "$value": "2rem" },
    "7": { "$value": "2.5rem" },
    "8": { "$value": "3rem" },
    "9": { "$value": "4rem" },
    "10": { "$value": "6rem" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "0.375rem" },
    "md": { "$value": "0.625rem" },
    "lg": { "$value": "1rem" },
    "pill": { "$value": "999px" }
  },
  "layout": {
    "$type": "dimension",
    "content": { "$value": "72rem" },
    "prose": { "$value": "42rem" },
    "gutter": { "$value": "clamp(1rem, 0.6rem + 1.8vw, 2rem)" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms" },
      "base": { "$value": "200ms" },
      "slow": { "$value": "320ms" }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)" }
    }
  }
}

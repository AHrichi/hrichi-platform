{
  "color": {
    "$type": "color",
    "bg": {
      "canvas": { "$value": "{color.neutral.950}" },
      "surface": { "$value": "{color.neutral.900}" },
      "raised": { "$value": "{color.neutral.800}" },
      "inverse": { "$value": "{color.neutral.50}" }
    },
    "text": {
      "default": { "$value": "{color.neutral.50}" },
      "muted": { "$value": "{color.neutral.400}" },
      "inverse": { "$value": "{color.neutral.900}" }
    },
    "border": {
      "default": { "$value": "{color.neutral.800}" },
      "strong": { "$value": "{color.neutral.700}" }
    },
    "accent": {
      "default": { "$value": "{color.crimson.400}" },
      "hover": { "$value": "{color.crimson.300}" },
      "subtle": { "$value": "{color.crimson.900}" },
      "on": { "$value": "{color.neutral.950}" }
    },
    "success": {
      "default": { "$value": "{color.green.400}" }
    },
    "focus": {
      "ring": { "$value": "{color.crimson.300}" }
    },
    "stage": {
      "$description": "Dark panel behind 3D scenes in both themes: additive glow needs a dark background",
      "bg": { "$value": "{color.neutral.950}" },
      "text": { "$value": "{color.neutral.50}" },
      "muted": { "$value": "{color.neutral.400}" },
      "border": { "$value": "{color.neutral.800}" }
    },
    "data": {
      "$description": "Categorical palette for graphics on the stage; each needs 3:1 against stage.bg",
      "1": { "$value": "{color.crimson.400}" },
      "2": { "$value": "{color.amber.300}" },
      "3": { "$value": "{color.teal.300}" },
      "4": { "$value": "{color.blue.300}" },
      "5": { "$value": "{color.violet.300}" },
      "6": { "$value": "{color.neutral.300}" },
      "7": { "$value": "{color.green.400}" }
    }
  },
  "shadow": {
    "raised": {
      "$value": "0 1px 2px rgb(0 0 0 / 40%), 0 4px 16px rgb(0 0 0 / 30%)"
    }
  }
}

{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": false,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@ah/platform/federation": ["./libs/platform/federation/src/index.ts"],
      "@ah/platform/inspector": ["./libs/platform/inspector/src/index.ts"],
      "@ah/design-system/tokens": ["./libs/design-system/tokens/src/index.ts"],
      "@ah/ui": ["./libs/design-system/ui/src/index.ts"],
      "@ah/shared/content": ["./libs/shared/content/src/index.ts"],
      "@ah/shared/state": ["./libs/shared/state/src/index.ts"],
      "@ah/shared/site-config": ["./libs/shared/site-config/src/index.ts"],
      "@ah/portfolio/util-seo": ["./libs/portfolio/util-seo/src/index.ts"],
      "@ah/portfolio/feature-home": [
        "./libs/portfolio/feature-home/src/index.ts"
      ],
      "@ah/portfolio/feature-work": [
        "./libs/portfolio/feature-work/src/index.ts"
      ],
      "@ah/portfolio/feature-experience": [
        "./libs/portfolio/feature-experience/src/index.ts"
      ],
      "@ah/portfolio/feature-services": [
        "./libs/portfolio/feature-services/src/index.ts"
      ],
      "@ah/portfolio/feature-cv": ["./libs/portfolio/feature-cv/src/index.ts"],
      "@ah/api/leads": ["./libs/api/leads/src/index.ts"],
      "@ah/shared/contracts": ["./libs/shared/contracts/src/index.ts"],
      "@ah/shared/api-client": ["./libs/shared/api-client/src/index.ts"],
      "@ah/labs/orbit/domain": ["./libs/labs/orbit/domain/src/index.ts"],
      "@ah/labs/orbit/feature": ["./libs/labs/orbit/feature/src/index.ts"],
      "@ah/three/scenes/orbit-globe": [
        "./libs/three/scenes/orbit-globe/src/index.ts"
      ],
      "@ah/three/engine": ["./libs/three/engine/src/index.ts"],
      "@ah/three/engine/quality": ["./libs/three/engine/src/quality.ts"],
      "@ah/three/angular": ["./libs/three/angular/src/index.ts"],
      "@ah/three/constellation": ["./libs/three/constellation/src/index.ts"],
      "@ah/three/scenes/constellation": [
        "./libs/three/scenes/constellation/src/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}

# Copy to apps/api/.env.local (git-ignored); Nx loads it for `nx serve api`.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=portfolio
# Cloudflare's always-pass Turnstile test secret. It pairs with the test site
# key the shell uses in development (tools/hosting/environments.json).
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
CORS_ORIGINS=http://localhost:4200

# Optional: real deliveries while developing. Leave unset to mark them disabled.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# N8N_WEBHOOK_URL=
# N8N_WEBHOOK_SECRET=

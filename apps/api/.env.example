# Copy to apps/api/.env.local (git-ignored); Nx loads it for `nx serve api`.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=portfolio
# Cloudflare's always-pass Turnstile test secret. It pairs with the test site
# key the shell uses in development (tools/hosting/environments.json).
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
CORS_ORIGINS=http://localhost:4200

# Optional: real deliveries while developing. Leave unset to mark them disabled.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# N8N_WEBHOOK_URL=
# N8N_WEBHOOK_SECRET=

# Optional: the Learning Engine (ADR-0024). Unset, its routes don't exist.
# At least 32 characters, e.g. `node -e "console.log(crypto.randomBytes(32).toString('base64url'))"`.
# LEARNING_TOKEN_SECRET=
# Pairing codes go to the Telegram chat above. Without a bot, log them instead (development only):
# LEARNING_LOG_PAIRING_CODES=true
# The capture pipeline's models (design §6). Each is optional; without Groq
# or Gemini, captures wait. Without TypeSafe, judging tasks use Groq/Gemini.
# GROQ_API_KEY=
# GEMINI_API_KEY=
# TYPESAFE_API_KEY=

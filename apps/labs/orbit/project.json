{
  "name": "lab-orbit",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "ah",
  "sourceRoot": "apps/labs/orbit/src",
  "tags": ["scope:lab-orbit", "type:app", "runtime:browser"],
  "targets": {
    "build": {
      "executor": "@angular-architects/native-federation:build",
      "defaultConfiguration": "production",
      "options": {
        "cacheExternalArtifacts": true,
        "tsConfig": "apps/labs/orbit/tsconfig.federation.json"
      },
      "configurations": {
        "production": {
          "target": "lab-orbit:esbuild:production"
        },
        "development": {
          "target": "lab-orbit:esbuild:development",
          "dev": true
        }
      }
    },
    "serve": {
      "executor": "@angular-architects/native-federation:build",
      "options": {
        "target": "lab-orbit:serve-original:development",
        "tsConfig": "apps/labs/orbit/tsconfig.federation.json",
        "rebuildDelay": 500,
        "cacheExternalArtifacts": true,
        "dev": true,
        "devServer": true,
        "port": 0
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false
      }
    },
    "serve-static": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/scripts/serve-static.mjs dist/apps/labs/orbit/browser 4302"
      }
    },
    "esbuild": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/labs/orbit",
        "browser": "apps/labs/orbit/src/main.ts",
        "tsConfig": "apps/labs/orbit/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/labs/orbit/public"
          }
        ],
        "styles": [
          "node_modules/@fontsource-variable/inter/index.css",
          "libs/design-system/tokens/src/generated/tokens.css",
          "libs/design-system/ui/src/styles/index.scss",
          "apps/labs/orbit/src/styles.scss"
        ],
        "polyfills": ["es-module-shims"],
        "webWorkerTsConfig": "apps/labs/orbit/tsconfig.worker.json"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve-original": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4302
      },
      "configurations": {
        "production": {
          "buildTarget": "lab-orbit:esbuild:production"
        },
        "development": {
          "buildTarget": "lab-orbit:esbuild:development"
        }
      }
    },
    "serve-cloudflare": {
      "continuous": true,
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node tools/scripts/prepare-hosting.mjs dist/apps/labs/orbit/browser --env development --app lab-orbit --cors --site-config",
          "wrangler dev --config apps/labs/orbit/wrangler.jsonc --port 4302"
        ],
        "parallel": false
      }
    },
    "deploy": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node tools/scripts/prepare-hosting.mjs dist/apps/labs/orbit/browser --env production --app lab-orbit --cors --site-config",
          "wrangler deploy --config apps/labs/orbit/wrangler.jsonc"
        ],
        "parallel": false
      },
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tools/scripts/prepare-hosting.mjs",
        "{workspaceRoot}/tools/hosting/environments.json"
      ]
    }
  }
}

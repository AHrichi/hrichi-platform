{
  "name": "shell",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "ah",
  "sourceRoot": "apps/portfolio/shell/src",
  "tags": ["scope:portfolio", "type:app", "runtime:browser"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-federation"],
      "outputs": ["{workspaceRoot}/dist/apps/portfolio/shell"],
      "defaultConfiguration": "production",
      "options": {
        "command": "ngsw-config dist/apps/portfolio/shell/browser apps/portfolio/shell/ngsw-config.json /"
      },
      "configurations": {
        "production": {},
        "development": {
          "command": "echo Service worker is disabled in development builds"
        }
      }
    },
    "build-federation": {
      "executor": "@angular-architects/native-federation:build",
      "options": {
        "cacheExternalArtifacts": true,
        "tsConfig": "apps/portfolio/shell/tsconfig.federation.json"
      },
      "configurations": {
        "production": {
          "target": "shell:esbuild:production"
        },
        "development": {
          "target": "shell:esbuild:development",
          "dev": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-architects/native-federation:build",
      "options": {
        "target": "shell:serve-original:development",
        "tsConfig": "apps/portfolio/shell/tsconfig.federation.json",
        "rebuildDelay": 500,
        "cacheExternalArtifacts": true,
        "dev": true,
        "devServer": true,
        "port": 0
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false
      }
    },
    "serve-static": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/scripts/serve-static.mjs dist/apps/portfolio/shell/browser 4200"
      }
    },
    "esbuild": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/portfolio/shell",
        "browser": "apps/portfolio/shell/src/main.ts",
        "tsConfig": "apps/portfolio/shell/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/portfolio/shell/public"
          }
        ],
        "styles": [
          "node_modules/@fontsource-variable/inter/index.css",
          "libs/design-system/tokens/src/generated/tokens.css",
          "libs/design-system/ui/src/styles/index.scss",
          "apps/portfolio/shell/src/styles.scss"
        ],
        "server": "apps/portfolio/shell/src/main.server.ts",
        "outputMode": "static",
        "polyfills": ["es-module-shims"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "bundles",
          "serviceWorker": "apps/portfolio/shell/ngsw-config.json"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve-original": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4200
      },
      "configurations": {
        "production": {
          "buildTarget": "shell:esbuild:production"
        },
        "development": {
          "buildTarget": "shell:esbuild:development"
        }
      }
    },
    "serve-cloudflare": {
      "continuous": true,
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node tools/scripts/prepare-hosting.mjs dist/apps/portfolio/shell/browser --env development --app shell --federation --not-found index.csr.html --sitemap --site-config",
          "node tools/scripts/cv-pdf.mjs dist/apps/portfolio/shell/browser",
          "wrangler dev --config apps/portfolio/shell/wrangler.jsonc --port 4200"
        ],
        "parallel": false
      }
    },
    "deploy": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node tools/scripts/prepare-hosting.mjs dist/apps/portfolio/shell/browser --env production --app shell --federation --not-found index.csr.html --sitemap --site-config",
          "node tools/scripts/cv-pdf.mjs dist/apps/portfolio/shell/browser",
          "wrangler deploy --config apps/portfolio/shell/wrangler.jsonc"
        ],
        "parallel": false
      },
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tools/scripts/prepare-hosting.mjs",
        "{workspaceRoot}/tools/federation/remotes.json",
        "{workspaceRoot}/tools/hosting/environments.json",
        "{workspaceRoot}/tools/scripts/cv-pdf.mjs"
      ]
    },
    "lighthouse": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "lhci autorun --config=apps/portfolio/shell/lighthouserc.json",
          "lhci autorun --config=apps/portfolio/shell/lighthouserc.desktop.json"
        ],
        "parallel": false
      }
    }
  }
}

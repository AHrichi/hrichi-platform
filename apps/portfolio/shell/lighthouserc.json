{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm exec nx run-many -t serve-static -p shell lab-hello --output-style=stream",
      "startServerReadyPattern": "Serving .*4200",
      "startServerReadyTimeout": 600000,
      "url": [
        "http://localhost:4200/",
        "http://localhost:4200/work/this-platform",
        "http://localhost:4200/experience",
        "http://localhost:4200/cv"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "dist/.lighthouse"
    }
  }
}

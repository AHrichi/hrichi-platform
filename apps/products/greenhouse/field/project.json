{
  "name": "product-greenhouse-field",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "gh",
  "sourceRoot": "apps/products/greenhouse/field/src",
  "tags": ["scope:product-greenhouse", "type:app", "runtime:browser"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/products/greenhouse/field",
        "browser": "apps/products/greenhouse/field/src/main.ts",
        "tsConfig": "apps/products/greenhouse/field/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/products/greenhouse/field/public"
          }
        ],
        "styles": [
          "node_modules/@fontsource-variable/inter/index.css",
          "libs/design-system/tokens/src/generated/tokens.css",
          "libs/design-system/ui/src/styles/index.scss",
          "apps/products/greenhouse/field/src/styles.scss"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "600kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "8kb",
              "maximumError": "16kb"
            }
          ],
          "outputHashing": "all",
          "serviceWorker": "apps/products/greenhouse/field/ngsw-config.json",
          "fileReplacements": [
            {
              "replace": "apps/products/greenhouse/field/src/environments/environment.ts",
              "with": "apps/products/greenhouse/field/src/environments/environment.production.ts"
            }
          ]
        },
        "demo": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "600kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "8kb",
              "maximumError": "16kb"
            }
          ],
          "outputHashing": "all",
          "serviceWorker": "apps/products/greenhouse/field/ngsw-config.json"
        },
        "local": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "600kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "8kb",
              "maximumError": "16kb"
            }
          ],
          "outputHashing": "all",
          "serviceWorker": "apps/products/greenhouse/field/ngsw-config.json",
          "fileReplacements": [
            {
              "replace": "apps/products/greenhouse/field/src/environments/environment.ts",
              "with": "apps/products/greenhouse/field/src/environments/environment.local.ts"
            }
          ]
        },
        "hosted": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "600kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "8kb",
              "maximumError": "16kb"
            }
          ],
          "outputHashing": "all",
          "serviceWorker": "apps/products/greenhouse/field/ngsw-config.json",
          "fileReplacements": [
            {
              "replace": "apps/products/greenhouse/field/src/environments/environment.ts",
              "with": "apps/products/greenhouse/field/src/environments/environment.hosted.ts"
            }
          ]
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "apps/products/greenhouse/field/src/environments/environment.ts",
              "with": "apps/products/greenhouse/field/src/environments/environment.local.ts"
            }
          ]
        },
        "brand-demo": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "600kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "8kb",
              "maximumError": "16kb"
            }
          ],
          "outputHashing": "all",
          "serviceWorker": "apps/products/greenhouse/field/ngsw-config.json",
          "fileReplacements": [
            {
              "replace": "apps/products/greenhouse/field/src/brand/brand.ts",
              "with": "apps/products/greenhouse/brands/active/brand.ts"
            }
          ],
          "styles": [
            "node_modules/@fontsource-variable/inter/index.css",
            "libs/design-system/tokens/src/generated/tokens.css",
            "libs/design-system/ui/src/styles/index.scss",
            "apps/products/greenhouse/field/src/styles.scss",
            "apps/products/greenhouse/brands/active/brand.css"
          ],
          "assets": [
            {
              "glob": "**/*",
              "input": "apps/products/greenhouse/field/public"
            },
            {
              "glob": "**/*",
              "input": "apps/products/greenhouse/brands/active/public"
            }
          ]
        },
        "brand-local": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "600kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "8kb",
              "maximumError": "16kb"
            }
          ],
          "outputHashing": "all",
          "serviceWorker": "apps/products/greenhouse/field/ngsw-config.json",
          "fileReplacements": [
            {
              "replace": "apps/products/greenhouse/field/src/environments/environment.ts",
              "with": "apps/products/greenhouse/field/src/environments/environment.local.ts"
            },
            {
              "replace": "apps/products/greenhouse/field/src/brand/brand.ts",
              "with": "apps/products/greenhouse/brands/active/brand.ts"
            }
          ],
          "styles": [
            "node_modules/@fontsource-variable/inter/index.css",
            "libs/design-system/tokens/src/generated/tokens.css",
            "libs/design-system/ui/src/styles/index.scss",
            "apps/products/greenhouse/field/src/styles.scss",
            "apps/products/greenhouse/brands/active/brand.css"
          ],
          "assets": [
            {
              "glob": "**/*",
              "input": "apps/products/greenhouse/field/public"
            },
            {
              "glob": "**/*",
              "input": "apps/products/greenhouse/brands/active/public"
            }
          ]
        },
        "brand-production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "600kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "8kb",
              "maximumError": "16kb"
            }
          ],
          "outputHashing": "all",
          "serviceWorker": "apps/products/greenhouse/field/ngsw-config.json",
          "fileReplacements": [
            {
              "replace": "apps/products/greenhouse/field/src/environments/environment.ts",
              "with": "apps/products/greenhouse/field/src/environments/environment.production.ts"
            },
            {
              "replace": "apps/products/greenhouse/field/src/brand/brand.ts",
              "with": "apps/products/greenhouse/brands/active/brand.ts"
            }
          ],
          "styles": [
            "node_modules/@fontsource-variable/inter/index.css",
            "libs/design-system/tokens/src/generated/tokens.css",
            "libs/design-system/ui/src/styles/index.scss",
            "apps/products/greenhouse/field/src/styles.scss",
            "apps/products/greenhouse/brands/active/brand.css"
          ],
          "assets": [
            {
              "glob": "**/*",
              "input": "apps/products/greenhouse/field/public"
            },
            {
              "glob": "**/*",
              "input": "apps/products/greenhouse/brands/active/public"
            }
          ]
        }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "continuous": true,
      "defaultConfiguration": "development",
      "options": {
        "port": 4314
      },
      "configurations": {
        "production": {
          "buildTarget": "product-greenhouse-field:build:production"
        },
        "development": {
          "buildTarget": "product-greenhouse-field:build:development"
        },
        "demo": {
          "buildTarget": "product-greenhouse-field:build:demo"
        },
        "local": {
          "buildTarget": "product-greenhouse-field:build:local"
        },
        "hosted": {
          "buildTarget": "product-greenhouse-field:build:hosted"
        },
        "brand-demo": {
          "buildTarget": "product-greenhouse-field:build:brand-demo"
        }
      }
    },
    "serve-static": {
      "continuous": true,
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/scripts/serve-static.mjs dist/apps/products/greenhouse/field/browser 4314"
      }
    },
    "cap-sync": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "cap sync",
        "cwd": "apps/products/greenhouse/field"
      }
    },
    "android-apk": {
      "dependsOn": ["cap-sync"],
      "executor": "nx:run-commands",
      "options": {
        "command": "java -classpath gradle/wrapper/gradle-wrapper.jar org.gradle.wrapper.GradleWrapperMain assembleDebug",
        "cwd": "apps/products/greenhouse/field/android"
      },
      "outputs": ["{projectRoot}/android/app/build/outputs/apk"],
      "cache": false
    }
  }
}

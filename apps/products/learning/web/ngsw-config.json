{
  "$schema": "../../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/favicon.svg",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/main-*.js",
          "/polyfills-*.js",
          "/_angular_*.js",
          "/_ah_*.js",
          "/_ngrx_signals.*.js",
          "/rxjs.*.js",
          "/rxjs_*.js",
          "!/_ngrx_signals_testing.*.js"
        ]
      }
    },
    {
      "name": "routes",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/*.js", "!/_ngrx_signals_testing.*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "federation-metadata",
      "urls": [
        "/federation.manifest.json",
        "/remoteEntry.json",
        "/importmap.json"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 10,
        "maxAge": "7d",
        "timeout": "3s"
      }
    },
    {
      "name": "runtime-config",
      "urls": ["/site-config.json"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 1,
        "maxAge": "7d",
        "timeout": "3s"
      }
    }
  ],
  "navigationRequestStrategy": "freshness"
}

{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "A night planner for stargazers: twilight, the Moon and moonless darkness for any place, computed with Orekit. Errors are RFC 9457 problem details.",
    "license" : {
      "name" : "MIT"
    },
    "title" : "Orbit API",
    "version" : "1"
  },
  "paths" : {
    "/nights" : {
      "get" : {
        "description" : "Sunset, twilight, sunrise, moonrise and moonset, the Moon's phase, windows of moonless astronomical darkness and active meteor showers, computed with Orekit. Nights run from local noon; in the morning, the first is the night just ending.",
        "operationId" : "nights",
        "parameters" : [ {
          "description" : "Degrees, north positive",
          "in" : "query",
          "name" : "lat",
          "required" : true,
          "schema" : {
            "type" : "number",
            "format" : "double",
            "maximum" : 90.0,
            "minimum" : -90.0
          }
        }, {
          "description" : "Degrees, east positive",
          "in" : "query",
          "name" : "lon",
          "required" : true,
          "schema" : {
            "type" : "number",
            "format" : "double",
            "maximum" : 180.0,
            "minimum" : -180.0
          }
        }, {
          "description" : "How many nights",
          "in" : "query",
          "name" : "days",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 14,
            "maximum" : 30,
            "minimum" : 1
          }
        }, {
          "description" : "IANA time zone for the dates, e.g. Africa/Tunis",
          "in" : "query",
          "name" : "zone",
          "required" : false,
          "schema" : {
            "type" : "string",
            "default" : "UTC"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/NightsResponse"
                }
              }
            },
            "description" : "OK"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Invalid parameters, each listed in errors"
          }
        },
        "summary" : "The coming nights at a place, for stargazing",
        "tags" : [ "night-controller" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "ActiveShower" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "rate" : {
            "type" : "number",
            "format" : "double"
          }
        },
        "required" : [ "id", "name", "rate" ]
      },
      "DarkWindow" : {
        "type" : "object",
        "properties" : {
          "end" : {
            "type" : "string",
            "format" : "date-time"
          },
          "start" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "required" : [ "end", "start" ]
      },
      "Night" : {
        "type" : "object",
        "properties" : {
          "astronomicalDawn" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "astronomicalDusk" : {
            "type" : [ "string", "null" ],
            "format" : "date-time",
            "description" : "Sun 18° below: truly dark"
          },
          "civilDawn" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "civilDusk" : {
            "type" : [ "string", "null" ],
            "format" : "date-time",
            "description" : "Sun 6° below the horizon"
          },
          "darkMinutes" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Total minutes in darkWindows"
          },
          "darkWindows" : {
            "type" : "array",
            "description" : "Astronomical darkness with the Moon below the horizon",
            "items" : {
              "$ref" : "#/components/schemas/DarkWindow"
            }
          },
          "date" : {
            "type" : "string",
            "format" : "date",
            "description" : "Local date of the evening"
          },
          "moonIllumination" : {
            "type" : "number",
            "format" : "double",
            "description" : "Lit fraction of the Moon at local midnight, 0–1"
          },
          "moonrise" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "moonset" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "nauticalDawn" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "nauticalDusk" : {
            "type" : [ "string", "null" ],
            "format" : "date-time",
            "description" : "Sun 12° below the horizon"
          },
          "score" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "0–100: hours of moonless darkness, up to six, plus a little for meteors"
          },
          "showers" : {
            "type" : "array",
            "description" : "Meteor showers active at local midnight, busiest first",
            "items" : {
              "$ref" : "#/components/schemas/ActiveShower"
            }
          },
          "sunrise" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "sunset" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          }
        },
        "required" : [ "astronomicalDawn", "astronomicalDusk", "civilDawn", "civilDusk", "darkMinutes", "darkWindows", "date", "moonIllumination", "moonrise", "moonset", "nauticalDawn", "nauticalDusk", "score", "showers", "sunrise", "sunset" ]
      },
      "NightsResponse" : {
        "type" : "object",
        "properties" : {
          "latitude" : {
            "type" : "number",
            "format" : "double",
            "description" : "Degrees, rounded to 0.1° (about 11 km)"
          },
          "longitude" : {
            "type" : "number",
            "format" : "double",
            "description" : "Degrees, rounded to 0.1°"
          },
          "nights" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Night"
            }
          },
          "zone" : {
            "type" : "string",
            "description" : "IANA time zone of the dates"
          }
        },
        "required" : [ "latitude", "longitude", "nights", "zone" ]
      },
      "ProblemDetail" : {
        "type" : "object",
        "properties" : {
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "type" : "string",
            "format" : "uri"
          },
          "properties" : {
            "type" : "object",
            "additionalProperties" : { }
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string",
            "format" : "uri"
          }
        }
      }
    }
  }
}

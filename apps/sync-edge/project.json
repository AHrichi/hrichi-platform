{
  "name": "sync-edge",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/sync-edge/src",
  "projectType": "application",
  "tags": ["scope:edge", "type:app", "runtime:agnostic"],
  "// targets": "build type-checks and bundles (CI runs it); deploy ships it from CI once its D1 database exists (deploy.mjs). Without SYNC_TOKEN_SECRET every route answers 503 (ADR-0032).",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/sync-edge"],
      "options": {
        "commands": [
          "tsc -p apps/sync-edge/tsconfig.app.json --noEmit",
          "wrangler deploy --dry-run --outdir dist/apps/sync-edge --config apps/sync-edge/wrangler.jsonc"
        ],
        "parallel": false
      }
    },
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "wrangler dev --config apps/sync-edge/wrangler.jsonc --port 8789"
      }
    },
    "deploy": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/sync-edge/deploy.mjs"
      }
    }
  }
}
